appname               = cli2api
version               = 0.6.22-1
display_name          = CLI2API
desc                  = <b>多提供商账号池 → OpenAI 兼容 API 网关</b>（基于上游 cli2api），内置官方 Web 控制台，安装即用。<br><br><b>支持渠道：</b>以 <b>WorkBuddy</b> 为主力（国内版 / 国际版），并支持 <b>Qoder 国际版 / 国内版</b>、<b>Trae 国内版 Work</b>，以及实验性的 <b>Devin</b> 与 <b>Command Code</b>。<br><br><b>标准接口：</b>/v1/chat/completions、/v1/models、/v1/messages、/v1/responses<br><br><b>账号池调度：</b>多账号加权轮转、会话粘性、失败重试与熔断冷却；跨渠道同名模型可调度，并可按账号启用每日签到。<br><br><b>控制台：</b>经飞牛统一网关接入，复用飞牛登录态、免密登录，仅管理员可访问。<br><br><b>下游接入：</b>独立端口 http://＜飞牛IP＞:3010/v1，任意 OpenAI SDK 直连。<br><br><b>运行时：</b>Qoder 渠道由内置 Node worker 驱动，依赖应用中心 Node.js 运行时（nodejs_v24，安装时自动带上）；其余渠道在 Go 进程内直连上游。

# 系统要求
# platform 由 build.py 按目标架构改写为 x86 / arm：每个 fpk 只装一个架构的二进制
# 与原生库（Qoder CLI 的 ripgrep、sharp/libvips），写成 all 会让另一种架构也能装上跑不起来的包。
platform              = all
os_min_version        = 1.2.0401
source                = thirdparty

# 开发者信息
maintainer            = caigee-cmd
maintainer_url        = https://github.com/caigee-cmd/cli2api

distributor           = yukihana
distributor_url       = https://github.com/sushazhi/fnos-cli2api

# 安装控制
ctl_stop              = true

# 下游接入端口（OpenAI 兼容客户端直连；取上游默认端口 3010，统一网关路径不给外部客户端用）
service_port          = 3010
checkport             = true

# 依赖运行时：Qoder worker（Node）由飞牛应用中心的 nodejs_v24 提供
install_dep_apps      = nodejs_v24

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = cli2api.Application

# 更新日志
changelog             = v0.6.22-1<br>1.上游 cli2api 同步至 v0.6.22（零源码改动）<br>2.每个账号可以把自己的真实模型映射成对外名字，也可以限制自己只接选中的目录模型。<br>3.额度耗尽的账号现在仍可路由到免费模型。Qoder 目录中部分模型单价为零（limited_time_free 标签或 price_factor 为零），请求不消耗积分，但路由池原先无条件排除所有额度耗尽的账号，导致这些账号的免费模型无账号可用。路由池现在在缓存模型列表的同时记录上游报价为零的模型，额度过滤对命中该名单的请求予以豁免。未报价的模型不视为免费；豁免按请求模型限定，额度耗尽的账号依旧不会出现在付费模型的路由上。<br>4.Qoder 聊天请求现在发送目录里的网关模型键。模型目录同时给出一个易读的公网 ID（qwen3.8-flash）和一个不同的网关键（qfmodel）。Worker 发送前会用账号目录把公网 ID 解析一遍，但进程内 COSY 客户端此前直接把调用方传入的名字填进 model_config.key。在只按映射键路由的账号上，这个请求不会得到任何响应——网关把它挂着，客户端一直等到自己的超时，既没有错误也没有数据。路由池现在记录目录给出的「公网 ID → 网关键」映射，聊天请求携带映射后的键。目录未给出不同键的账号保持公网 ID 原样。<br>5.修复 Qoder 多轮工具调用被上游以 400 InvalidParameter: messages with role "tool" must be a response to a preceeding message with "tool_calls" 拒绝的问题。上游网关只在前一条 assistant 消息的 content 为字符串时，才把它携带的 tool_calls 登记为可配对；OpenAI 客户端对纯工具调用轮次发送的正是 "content": null，导致调用未登记、后续 role:"tool" 消息被拒。进程内直连客户端现在会把工具调用轮次的 null content 改写为空字符串（网关接受该形状）；工具调用 id、工具结果与其他内容形状均原样保留。<br>6.WorkBuddy 每日签到成功后立即清除对应账号的冷却，让恢复的积分可以马上参与调度。
