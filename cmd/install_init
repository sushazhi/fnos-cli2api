#!/bin/bash
# cmd/install_init - 安装前置：只做校验，不创建数据目录。
#
# 重要（实测结论，2026-09）：
#   本应用使用 run-as=package。install_init 阶段以受限身份运行，
#   此时**不能**创建 ${TRIM_PKGVAR}（即 @appdata 下的应用数据目录）——
#   该目录由 fnOS 在挂载 var 软链时创建，或推迟到 install_callback。
#   目录创建放到 install_callback（此时环境已就绪）。

set -u

echo "正在检查 CLI2API 网关安装环境..."

# 只做非侵入式校验：确认关键环境变量已注入。
if [ -z "${TRIM_PKGVAR:-}" ]; then
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "Error: 安装器未提供 TRIM_PKGVAR，环境异常" >> "$TRIM_TEMP_LOGFILE"
    fi
    echo "Error: 安装器未提供 TRIM_PKGVAR，环境异常" >&2
    exit 1
fi

# Qoder worker 依赖 nodejs_v24（manifest 的 install_dep_apps 声明）。
# 应用中心会在本应用之前安装依赖；此处只告警不阻断——缺失时面板仍可用，
# 仅 Qoder 账号不可运行，用户在应用中心补装后重启应用即可。
if [ ! -x /var/apps/nodejs_v24/target/bin/node ]; then
    echo "警告：未找到 nodejs_v24 运行时（/var/apps/nodejs_v24/target/bin/node）。Qoder 账号将无法启动，请在应用中心安装 Node.js 运行时后重启本应用。"
fi

echo "安装前置检查通过"
exit 0
